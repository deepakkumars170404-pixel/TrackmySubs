    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.0.0",
    "imap-simple": "^5.1.0",
    "mailparser": "^3.12.4",
    "nodemailer": "^10.2.1",
    "resend": "^6.34.1",
